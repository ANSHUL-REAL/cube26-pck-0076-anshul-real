# Copy to .env and fill in. Never commit .env.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run `python -m pack_manager models` to see which models your key can use.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=25
GEMINI_MAX_RETRIES=1
# Optional. Leave empty to use the model's default thinking behaviour.
GEMINI_THINKING_BUDGET=

# Paid-tier list price of GEMINI_MODEL in USD per 1M tokens, copied from Google's
# published pricing page. Used only to report cost per box. Leave empty to skip.
COST_PER_1M_INPUT_USD=
COST_PER_1M_OUTPUT_USD=

# Postgres. The app connects as a role that is NOT the table owner, NOT a superuser
# and has no BYPASSRLS, otherwise row-level security is silently skipped.
# With a hosted Postgres (e.g. Neon), set only DATABASE_ADMIN_URL and leave DATABASE_URL
# empty: `python -m app.migrate` writes the pack_app connection string here.
DATABASE_URL=postgresql://pack_app:pack_app_dev@localhost:5432/pack_manager
# Used only by `python -m app.migrate` to create tables, policies and the app role.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/pack_manager
PACK_APP_DB_PASSWORD=pack_app_dev

# Web app: AI checks allowed per organisation per UTC day (0 = no limit). Boxes over the
# limit are saved as pending for a hand check. Protects a free-tier or shared API key.
DAILY_CHECKS_PER_ORG=60

# Signs the session cookie. Use a long random string in production.
SESSION_SECRET=change-me
